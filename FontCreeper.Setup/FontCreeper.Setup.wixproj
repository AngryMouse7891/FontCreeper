<Project Sdk="WixToolset.Sdk/7.0.0">
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FontCreeper\FontCreeper.csproj" />
  </ItemGroup>
  <PropertyGroup>
	<IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
    <IsWindows Condition="'$(OS)' != 'Windows_NT'">false</IsWindows>
    <AcceptEula>wix7</AcceptEula>
    <Version>1.1.0</Version>
    <Cultures>zh-CN;</Cultures>
    <OutputName>FontCreeper.$(Version).windows-$(Platform)</OutputName>
    <OutputType>Package</OutputType>
  </PropertyGroup>
</Project>