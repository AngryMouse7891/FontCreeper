<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PackageId>FontCreeper</PackageId>
	<Version>1.0.0</Version>
	<TargetFramework>net10.0</TargetFramework>
	<ApplicationIcon>favicon.ico</ApplicationIcon>
	<PublishAot>True</PublishAot>
	<PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
	  <Content Include="favicon.ico" CopyToPublishDirectory="PreserveNewest">
		  <LinuxPath>/usr/share/icons/FonrCreeper.ico</LinuxPath>
	  </Content>
	  <Content Include="FontCreeper.desktop" CopyToPublishDirectory="PreserveNewest">
		  <LinuxPath>/usr/share/applications/FontCreeper.desktop</LinuxPath>
	  </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

</Project>
