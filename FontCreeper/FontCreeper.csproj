<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PackageId>FontCreeper</PackageId>
	<Version>1.0.1</Version>
	<AssemblyVersion>1.0.1.0</AssemblyVersion>
	<TargetFramework>net10.0</TargetFramework>
	<ApplicationIcon>favicon.ico</ApplicationIcon>
	<SelfContained>true</SelfContained>
	<AssemblyBuildTime>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</AssemblyBuildTime>
  </PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BuildTime</_Parameter1>
			<_Parameter2>$(AssemblyBuildTime)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
	  <Content Include="FontCreeper.png" CopyToPublishDirectory="PreserveNewest">
		  <LinuxPath>/usr/share/icons/FontCreeper.png</LinuxPath>
	  </Content>
	  <Content Include="FontCreeper.desktop" CopyToPublishDirectory="PreserveNewest">
		  <LinuxPath>/usr/share/applications/FontCreeper.desktop</LinuxPath>
	  </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>
	

</Project>
